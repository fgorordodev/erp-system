{
  "name": "@erp/database",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "watch": "tsc -p tsconfig.json --watch",
    "build": "pnpm run db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm run db:generate && tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@erp/rbac": "workspace:*",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@erp/tsconfig": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
