# Application
NODE_ENV=development

# Backend
BACKEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HTTP security
REQUEST_BODY_LIMIT=100kb
TRUST_PROXY=false

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

AUTH_PASSWORD_RESET_TOKEN_BYTES=32
AUTH_PASSWORD_RESET_EXPIRES_MS=900000
AUTH_PASSWORD_RESET_URL=http://localhost:5173/reset-password

THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=5

THROTTLE_REFRESH_TTL_MS=60000
THROTTLE_REFRESH_LIMIT=10

# Database / Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erp_system
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_system

# JWT
# Generate each secret independently, for example: openssl rand -hex 64
JWT_ACCESS_SECRET=d476575f27c9384a6f64436965b1448a205b95b2b7c13a4ce90ddf692ea1b0e56f980af16a15738e55c4767fb647c600d05345d393f9dc57666d30feb061ab02
JWT_REFRESH_SECRET=4f4d6d66a80032406ef133a3ba0905f10207b393b4c2f943be16d0692e5aa0c143ad0da2367c412454c7dfb54f301cd0331471d71be4908be3749b58cb00e71c
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AES-256-GCM
# Must contain exactly 64 hexadecimal characters: openssl rand -hex 32
ENCRYPTION_KEY=13ee353ec72b1bf5cfa7aeea96da80a902549fe660f16fb86c0a183ac4f06146

# Development seed administrator
SEED_ADMIN_EMAIL=admin@erp.local
SEED_ADMIN_PASSWORD=change-this-development-password
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
